// Where each step's outputs are published. Intermediate FASTQs are not
// published: they are large and can be regenerated from the BAMs.
process {
    withName: 'CHECK_READS' {
        publishDir = [path: { "${params.outdir}/reads_check" }, mode: 'copy', pattern: '*.log']
    }
    withName: 'STAR_GENOMEGENERATE' {
        publishDir = [path: { "${params.outdir}/reference" }, mode: 'copy', pattern: 'star_index']
    }
    withName: 'STARSOLO' {
        publishDir = [path: { "${params.outdir}/starsolo/${meta.id}" }, mode: 'copy', pattern: '*{Solo.out,Log.final.out}']
    }
    withName: 'SAMPLE_QC' {
        publishDir = [path: { "${params.outdir}/qc" }, mode: 'copy', pattern: '*.{tsv.gz,json}']
    }
    withName: 'PREP_PUBLISHED' {
        publishDir = [path: { "${params.outdir}/published" }, mode: 'copy', pattern: '*.summary.json']
    }
    withName: 'CONCORDANCE|SUMMARISE_CONCORDANCE' {
        publishDir = [path: { "${params.outdir}/concordance" }, mode: 'copy']
    }
}
