// Tiny synthetic dataset (tests/data, regenerated by make_test_data.py).
// Two samples cover both bamtofastq read layouts (cDNA as R2 and as R3).
params {
    input            = "${projectDir}/tests/data/samplesheet.csv"
    outdir           = 'results_test'
    genome_fasta     = "${projectDir}/tests/data/genome.fa"
    genome_gtf       = "${projectDir}/tests/data/genes.gtf"
    star_genome_sa_index_nbases = 6
    star_sjdb_overhang = 89
    whitelist_v3     = "${projectDir}/tests/data/whitelist_v3.txt"
    published_counts = "${projectDir}/tests/data/published_counts.csv"
    // Test runs must not depend on whether the real criteria are locked yet.
    allow_unlocked_criteria = true
    // Cell Ranger 2.2-style calling: the tiny dataset has 20 cells per sample.
    solo_cell_filter = 'CellRanger2.2 20 0.99 10'
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
    withLabel: 'process_high' { cpus = 2; memory = 4.GB }
    withLabel: 'process_medium' { cpus = 2; memory = 2.GB }
    withLabel: 'process_r_high' { memory = 2.GB }
    withLabel: 'process_r' { memory = 2.GB }
}
