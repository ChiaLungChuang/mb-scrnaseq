/*
 * St. Jude HPCF profile: IBM Spectrum LSF + Singularity.
 *
 * Adapted from the nf-core institutional config for St. Jude
 * (https://github.com/nf-core/configs/blob/master/conf/stjude.config, MIT):
 * same executor, queue routing and Singularity module, trimmed to what this
 * pipeline uses.
 *
 * HPCF policy (HPCF wiki, "Introduction to the HPCF cluster"): the login
 * nodes (hpc.stjude.org) are only for changing directories and submitting
 * jobs. Nextflow's head process submits every task with bsub, so it runs on
 * a compute node, inside an interactive session (hpcf_interactive) or as a
 * batch job (docs/RUNBOOK.md, sections 3 and 9), never on the login node. Whether
 * a compute node can submit jobs is checked by
 * `scripts/hpcf_preflight.sh --submit-test`.
 *
 * Memory. HPCF reserves memory per core: rusage[mem] is multiplied by the
 * job's slots. perTaskReserve = true makes Nextflow divide the request by
 * the CPUs, so the total comes out right. For a task with 8 CPUs and 48 GB,
 * Nextflow 26.10.4 (LsfExecutor.getDirectives) writes
 *   -n 8 -R "span[hosts=1]" -M 6144MB -R "select[mem>=49152MB] rusage[mem=6144MB]"
 * i.e. 6144 MB per slot x 8 slots = 48 GB reserved, on one host. Units are
 * written as MB, so LSF_UNIT_FOR_LIMITS does not matter. Nextflow reads
 * lsf.conf's LSB_JOB_MEMLIMIT and RESOURCE_RESERVE_PER_TASK, but in 26.10.4
 * both executor settings are plain booleans (ExecutorConfig), so an unset
 * one is false and lsf.conf never wins. Both are set here so that a later
 * Nextflow that honours lsf.conf cannot change the request either
 * (tests/shell/test_stjude_lsf.sh checks with and without an lsf.conf).
 * Pending HPCF: -M is a per-process limit unless LSB_JOB_MEMLIMIT=Y, and
 * STAR is one multi-threaded process that can use all 48 GB. Whether HPCF
 * enforces -M per process, per job or through cgroups decides whether
 * perJobMemLimit should be true (-M 49152MB); the preflight reports the
 * lsf.conf settings that answer it.
 *
 * Queues: standard (default), short (30-minute hard limit), large_mem
 * (recommended above 1 TB), heavy_io (I/O-intensive) and interactive. This
 * profile uses the first three. Per-user limits are 50,000 pending and 5,000
 * running jobs; queueSize = 100 stays far below them.
 *
 * Compared with nf-core/configs conf/stjude.config at commit d1a3f858
 * (30 Oct 2026). Executor settings, resource limits, the LSF retry rule
 * and the Singularity settings agree (submitRateLimit '10 sec' parses as
 * nf-core's '10/1sec': 10 submissions per second). Deliberate differences:
 * - SINGULARITY_TMPDIR is set from the job's $TMPDIR when the job runs.
 *   nf-core writes "${System.getenv('TMPDIR')}" in a double-quoted string,
 *   which Nextflow fills in once, from the login node's TMPDIR, when it
 *   reads the config.
 * - No `cleanup = true`: it deletes work/ after a successful run, and this
 *   pipeline relies on -resume (pilot, then all samples).
 * - No gpu queue branch, accelerator clusterOptions or CUDA_VISIBLE_DEVICES:
 *   no step uses a GPU. Add them from nf-core if phase 2 trains scVI on GPU.
 * - maxRetries = 2 (conf/base.config, which raises memory and time on each
 *   attempt); nf-core sets 3.
 * - large_mem only above 1 TB, as HPCF recommends; nf-core uses 512 GB.
 * - The queue rule tolerates a task with no time or memory set; nf-core
 *   compares task.time directly. nf-core's legacy params.max_* and
 *   config_profile_* are not used by this pipeline.
 *
 * Before the first run, set a Singularity cache in your shell profile
 * (there is no shared one), e.g.:
 *   export NXF_SINGULARITY_CACHEDIR=/path/you/own/singularity_cache
 */
process {
    executor = 'lsf'
    cache    = 'lenient'
    resourceLimits = [cpus: 32, memory: 1024.GB, time: 240.h]

    beforeScript = '''
module load singularity/4.1.1
export SINGULARITY_TMPDIR="$TMPDIR"
'''
    afterScript = 'sleep 10'

    // Jobs of 30 minutes or less to 'short' (its hard limit), more than 1 TB
    // to 'large_mem' (HPCF's recommendation), the rest to 'standard'. With
    // resourceLimits.memory at 1024 GB no task currently exceeds 1 TB; this
    // pipeline's largest request is 48 GB x 3 attempts = 144 GB. Raising the
    // limit waits on HPCF's large_mem node size.
    queue = {
        if (task.time && task.time <= 30.min) {
            'short'
        } else if (task.memory && task.memory > 1024.GB) {
            'large_mem'
        } else {
            'standard'
        }
    }
}

singularity {
    enabled     = true
    autoMounts  = true
    pullTimeout = '3 h'
    envWhitelist = 'SINGULARITY_TMPDIR,TMPDIR'
    runOptions  = '-p -B "$TMPDIR"'
}
docker.enabled = false

executor {
    name            = 'lsf'
    queueSize       = 100
    perTaskReserve  = true
    perJobMemLimit  = false
    submitRateLimit = '10 sec'
    exitReadTimeout = '5 min'
    jobName         = { task.name.replace('[', '(').replace(']', ')').replace(' ', '_') }
}
