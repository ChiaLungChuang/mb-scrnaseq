/*
 * St. Jude HPCF profile: IBM Spectrum LSF + Singularity.
 *
 * Adapted from the nf-core institutional config for St. Jude
 * (https://github.com/nf-core/configs/blob/master/conf/stjude.config, MIT):
 * same executor, queue routing and Singularity module, trimmed to what this
 * pipeline uses. Nextflow must be launched from a login node, because it
 * submits jobs with bsub.
 *
 * Compared with nf-core/configs conf/stjude.config at commit d1a3f858
 * (30 Oct 2026). Executor settings, resource limits, the LSF retry rule
 * and the Singularity settings agree (submitRateLimit '10 sec' parses as
 * nf-core's '10/1sec': 10 submissions per second). Deliberate differences:
 * - SINGULARITY_TMPDIR is set from the job's $TMPDIR when the job runs.
 *   nf-core writes "${System.getenv('TMPDIR')}" in a double-quoted string,
 *   which Nextflow fills in once, from the login node's TMPDIR, when it
 *   reads the config.
 * - No `cleanup = true`: it deletes work/ after a successful run, and this
 *   pipeline relies on -resume (pilot, then all samples).
 * - No gpu queue branch, accelerator clusterOptions or CUDA_VISIBLE_DEVICES:
 *   no step uses a GPU. Add them from nf-core if phase 2 trains scVI on GPU.
 * - maxRetries = 2 (conf/base.config, which raises memory and time on each
 *   attempt); nf-core sets 3.
 * - The queue rule tolerates a task with no time or memory set; nf-core
 *   compares task.time directly. nf-core's legacy params.max_* and
 *   config_profile_* are not used by this pipeline.
 *
 * Before the first run, set a Singularity cache in your shell profile
 * (there is no shared one), e.g.:
 *   export NXF_SINGULARITY_CACHEDIR=/path/you/own/singularity_cache
 */
process {
    executor = 'lsf'
    cache    = 'lenient'
    resourceLimits = [cpus: 32, memory: 1024.GB, time: 240.h]

    beforeScript = '''
module load singularity/4.1.1
export SINGULARITY_TMPDIR="$TMPDIR"
'''
    afterScript = 'sleep 10'

    // Short jobs to 'short', very large memory to 'large_mem', the rest to 'standard'.
    queue = {
        if (task.time && task.time <= 30.min) {
            'short'
        } else if (task.memory && task.memory > 512.GB) {
            'large_mem'
        } else {
            'standard'
        }
    }
}

singularity {
    enabled     = true
    autoMounts  = true
    pullTimeout = '3 h'
    envWhitelist = 'SINGULARITY_TMPDIR,TMPDIR'
    runOptions  = '-p -B "$TMPDIR"'
}
docker.enabled = false

executor {
    name            = 'lsf'
    queueSize       = 100
    perTaskReserve  = true
    perJobMemLimit  = false
    submitRateLimit = '10 sec'
    exitReadTimeout = '5 min'
    jobName         = { task.name.replace('[', '(').replace(']', ')').replace(' ', '_') }
}
