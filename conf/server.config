/*
 * One Linux server or workstation without a scheduler: every task runs on
 * this machine with Nextflow's local executor. Use it with a container
 * profile:
 *
 *   nextflow run . -profile server,singularity --server_cpus 32 --server_memory '200.GB' ...
 *   (or server,apptainer / server,docker)
 *
 * --server_cpus and --server_memory are the share of the machine this run
 * may use (on a shared machine, not all of it). They cap every task
 * (process.resourceLimits: a step that asks for more gets this much) and
 * everything running at once (executor.cpus / executor.memory: the local
 * executor starts a task only when its cores and memory are free).
 *
 * At launch the pipeline refuses to start (main.nf, checkServer) when:
 *   - either value is missing, or more than the machine has;
 *   - --server_memory is below --server_min_memory (48 GB: the STAR index
 *     build and STARsolo ask for 48 GB, conf/base.config);
 *   - the work directory's file system has less free space than one tumor
 *     needs: its FASTQs (1.7 times its BAM, the upper end measured in
 *     tests/scale), a STAR index built here and its published copy (about
 *     10 times the genome FASTA each), and --server_disk_margin.
 * See docs/RUNBOOK.md, "Route 2: a standalone server".
 */
params {
    server_check = true
}

process {
    executor       = 'local'
    resourceLimits = params.server_cpus && params.server_memory ?
        [cpus: params.server_cpus as int, memory: nextflow.util.MemoryUnit.of(params.server_memory as String)] : null
}

executor {
    name   = 'local'
    cpus   = params.server_cpus ? params.server_cpus as int : null
    memory = params.server_memory ? nextflow.util.MemoryUnit.of(params.server_memory as String) : null
}
