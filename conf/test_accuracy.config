// Accuracy dataset (tests/data/accuracy, written by make_accuracy_data.py):
// every read type whose counting can go wrong (PCR duplicates, barcode and
// UMI errors, spliced, minus-strand, antisense, intronic, intergenic and
// multi-mapping reads), with the correct count known for every cell and
// gene. v3 and v2 chemistry, both bamtofastq layouts.
// Applied on top of conf/test.config (see the test_accuracy profile).
params {
    input              = "${projectDir}/tests/data/accuracy/samplesheet.csv"
    outdir             = 'results_accuracy'
    genome_fasta       = "${projectDir}/tests/data/accuracy/genome.fa"
    genome_gtf         = "${projectDir}/tests/data/accuracy/genes.gtf"
    star_sjdb_overhang = 97
    whitelist_v2       = "${projectDir}/tests/data/accuracy/whitelist_v2.txt"
    whitelist_v3       = "${projectDir}/tests/data/accuracy/whitelist_v3.txt"
    published_counts   = "${projectDir}/tests/data/accuracy/published_counts.csv"
    solo_cell_filter   = 'CellRanger2.2 12 0.99 10'
}
