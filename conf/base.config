// Default resources by label. Exit codes 130-145 and 104 (killed for memory
// or time; LSF often reports a memory kill as 130) are retried with more
// resources. Anything else is a real error: no new jobs are submitted,
// running ones are allowed to finish, and the run then fails ('finish',
// as in the nf-core St. Jude config). Fix the cause and re-run with -resume.
process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    cpus          = 1
    memory        = 4.GB
    time          = 1.h
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = { 48.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    // PREP_PUBLISHED and CONCORDANCE. Measured at full size on synthetic
    // inputs (tests/scale/README.md): peaks of 3.3 and 3.4 GB, up to 4.8
    // and 5.8 GB on a dense case, and at most 4 minutes on one core.
    withLabel: 'process_r' {
        cpus   = 1
        memory = { 12.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
