// Default resources by label. Memory-bound failures are retried with more
// memory; anything else fails immediately so real errors are not hidden.
process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    cpus          = 1
    memory        = 4.GB
    time          = 1.h
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = { 48.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel: 'process_r' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_r_high' {
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}
