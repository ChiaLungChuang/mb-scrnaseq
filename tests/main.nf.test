nextflow_pipeline {

    name "mb-scrnaseq phase 1 on the synthetic dataset"
    script "../main.nf"

    test("re-quantification reproduces the synthetic ground truth") {
        when {
            params {
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success

            def verdict = new groovy.json.JsonSlurper().parse(file("$outputDir/concordance/concordance_summary.verdict.json"))
            assert verdict.passed
            assert verdict.n_samples == 2
            // Test runs are never marked as pre-registered.
            assert verdict.preregistered == false
            assert verdict.code_sha256 ==~ /[0-9a-f]{64}/

            // The count matrices themselves are published, not only the logs.
            ['raw', 'filtered'].each { d ->
                assert file("$outputDir/starsolo/sampleA/sampleA.Solo.out/Gene/${d}/matrix.mtx").exists()
            }
            assert file("$outputDir/starsolo/sampleB/sampleB.Solo.out/Gene/Summary.csv").exists()

            // Both bamtofastq layouts were exercised.
            def logs = file("$outputDir/reads_check").listFiles().collect { f -> f.text }.join('\n')
            assert logs.contains('cDNA read is R2')
            assert logs.contains('cDNA read is R3')

            // Every true cell's UMI total matches the generator's truth exactly.
            def truth = new groovy.json.JsonSlurper().parse(file("${projectDir}/tests/data/truth.json"))
            ['sampleA', 'sampleB'].each { s ->
                def rows = path("$outputDir/concordance/${s}.per_cell.tsv.gz").linesGzip.drop(1)*.split('\t')
                assert rows.size() == 20
                rows.each { r -> assert (r[1] as double) == truth[s].cells[r[0]].total_umi }

                // QC flags exactly the three planted low-quality cells.
                def qc = path("$outputDir/qc/${s}.qc_cells.tsv.gz").linesGzip
                def header = qc[0].split('\t') as List
                def flagged = qc.drop(1)*.split('\t').findAll { r -> r[header.indexOf('flag_any')] == 'TRUE' }.collect { r -> r[0].split('-')[0] } as Set
                def planted = truth[s].cells.findAll { _cb, v -> v.low_quality }.keySet()
                assert flagged == planted
            }

            def prov = new groovy.json.JsonSlurper().parse(file("$outputDir/pipeline_info/run_provenance.json"))
            assert prov.success
            assert prov.preregistration.sha256 ==~ /[0-9a-f]{64}/
            assert prov.code_sha256 == verdict.code_sha256
            assert file("$outputDir/pipeline_info/software_versions.yml").text.count('STARSOLO') == 1

            // Every R step stays within its CPUs: each logs the threads it
            // may use, which must equal the task's cpus (1 here). Without
            // the limits, data.table takes half the machine's cores and the
            // BLAS/OpenMP variables are unset.
            def trace = new File(new File("$outputDir").parentFile, 'meta/trace.csv').readLines()*.split('\t')
            def col = trace[0] as List
            def rTasks = trace.drop(1).findAll { r -> r[col.indexOf('process')] in ['PREP_PUBLISHED', 'SAMPLE_QC', 'CONCORDANCE', 'SUMMARISE_CONCORDANCE'] }
            assert rTasks.collect { r -> r[col.indexOf('process')] }.toSet().size() == 4
            rTasks.each { r ->
                def n = r[col.indexOf('cpus')]
                def log = new File(r[col.indexOf('workdir')], '.command.err').text
                def want = "threads: data.table ${n}, OMP_NUM_THREADS=${n}, OMP_THREAD_LIMIT=${n}, OPENBLAS_NUM_THREADS=${n}, MKL_NUM_THREADS=${n}"
                assert log.contains(want) : "${r[col.indexOf('process')]} (${n} CPUs): ${log.readLines().find { l -> l.startsWith('threads:') } ?: 'no threads line'}"
            }
        }
    }

    test("a sample declared with the wrong chemistry is refused") {
        when {
            new File("$outputDir").mkdirs()
            new File("$outputDir/wrong_chemistry.csv").text =
                "sample,bam,chemistry,published_label\nsampleA,${projectDir}/tests/data/sampleA.bam,v2,MB001\n"
            params {
                outdir = "$outputDir"
                input  = "$outputDir/wrong_chemistry.csv"
                whitelist_v2 = "${projectDir}/tests/data/whitelist_v3.txt"
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('chemistry v2 needs 26')
        }
    }

    test("swapped sample labels fail barcode recovery instead of passing") {
        when {
            new File("$outputDir").mkdirs()
            new File("$outputDir/swapped.csv").text =
                "sample,bam,chemistry,published_label\n" +
                "sampleA,${projectDir}/tests/data/sampleA.bam,v3,MB002\n" +
                "sampleB,${projectDir}/tests/data/sampleB.bam,v3,MB001\n"
            params {
                outdir = "$outputDir"
                input  = "$outputDir/swapped.csv"
            }
        }
        then {
            // A failed criterion is a result: the run succeeds and records the failure.
            assert workflow.success
            def verdict = new groovy.json.JsonSlurper().parse(file("$outputDir/concordance/concordance_summary.verdict.json"))
            assert !verdict.passed
            assert verdict.n_samples_passed == 0
            assert 'C1_barcode_recovery' in verdict.failing_criteria
            def a = new groovy.json.JsonSlurper().parse(file("$outputDir/concordance/sampleA.concordance.json"))
            assert a.metrics.barcode_recovery == 0
        }
    }

    test("concordance refuses to run against unlocked criteria") {
        when {
            // An unlocked, untracked copy, so this test does not depend on
            // whether the real criteria file has been locked yet.
            new File("$outputDir").mkdirs()
            new File("$outputDir/criteria_unlocked.yaml").text =
                new File("${projectDir}/preregistration/acceptance_criteria.yaml").text.replaceFirst(/(?m)^status:.*$/, 'status: proposed')
            params {
                outdir = "$outputDir"
                criteria = "$outputDir/criteria_unlocked.yaml"
                // A string, as it arrives from the command line: must still mean false.
                allow_unlocked_criteria = "false"
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('not pre-registered')
        }
    }

    test("a run that allows unlocked criteria is not pre-registered, even when they are locked and pushed") {
        when {
            // A locked criteria file, committed and pushed to a remote in a
            // scratch git repository, so every check on the criteria passes.
            def out = new File("$outputDir"); out.mkdirs()
            def git = { File dir, List args ->
                def p = (['git', '-c', 'user.name=test', '-c', 'user.email=test@example.org', '-C', dir.path] + args).execute()
                def err = p.err.text
                p.waitFor()
                assert p.exitValue() == 0 : "git ${args}: ${err}"
            }
            def repo = new File(out, 'criteria_repo'); repo.mkdirs()
            git(out, ['init', '-q', '--bare', 'remote.git'])
            git(repo, ['init', '-q', '-b', 'main'])
            new File(repo, 'acceptance_criteria.yaml').text =
                new File("${projectDir}/preregistration/acceptance_criteria.yaml").text.replaceFirst(/(?m)^status:.*$/, 'status: locked')
            git(repo, ['add', 'acceptance_criteria.yaml'])
            git(repo, ['commit', '-q', '-m', 'lock'])
            git(repo, ['remote', 'add', 'origin', '../remote.git'])
            git(repo, ['push', '-q', 'origin', 'main'])
            params {
                outdir = "$outputDir"
                criteria = "$outputDir/criteria_repo/acceptance_criteria.yaml"
                allow_unlocked_criteria = true
            }
        }
        then {
            assert workflow.success
            def pre = new groovy.json.JsonSlurper().parse(file("$outputDir/pipeline_info/preregistration_check.json"))
            // The criteria's own checks all pass...
            assert pre.locked && pre.tracked && !pre.uncommitted_changes && pre.pushed_to
            // ...but the gate was switched off, so the run is not pre-registered, and says why.
            assert pre.preregistered == false
            assert pre.problems.any { p -> p.contains('--allow_unlocked_criteria') }
            def verdict = new groovy.json.JsonSlurper().parse(file("$outputDir/concordance/concordance_summary.verdict.json"))
            assert verdict.preregistered == false
        }
    }

    test("locked, committed and pushed criteria pass the gate when it is enforced") {
        when {
            def out = new File("$outputDir"); out.mkdirs()
            def git = { File dir, List args ->
                def p = (['git', '-c', 'user.name=test', '-c', 'user.email=test@example.org', '-C', dir.path] + args).execute()
                def err = p.err.text
                p.waitFor()
                assert p.exitValue() == 0 : "git ${args}: ${err}"
            }
            def repo = new File(out, 'criteria_repo'); repo.mkdirs()
            git(out, ['init', '-q', '--bare', 'remote.git'])
            git(repo, ['init', '-q', '-b', 'main'])
            new File(repo, 'acceptance_criteria.yaml').text =
                new File("${projectDir}/preregistration/acceptance_criteria.yaml").text.replaceFirst(/(?m)^status:.*$/, 'status: locked')
            git(repo, ['add', 'acceptance_criteria.yaml'])
            git(repo, ['commit', '-q', '-m', 'lock'])
            git(repo, ['remote', 'add', 'origin', '../remote.git'])
            git(repo, ['push', '-q', 'origin', 'main'])
            params {
                outdir = "$outputDir"
                criteria = "$outputDir/criteria_repo/acceptance_criteria.yaml"
                allow_unlocked_criteria = "false"
            }
        }
        then {
            // The gate also needs the pipeline's own code committed: true in
            // CI, not while editing. Either way the outcome is determined.
            def p = ['git', '-C', "${projectDir}", 'status', '--porcelain', '--untracked-files=no'].execute()
            def codeDirty = p.text.trim()
            p.waitFor()
            if (codeDirty) {
                assert workflow.failed
                assert (workflow.stdout + workflow.stderr).join('\n').contains('the pipeline code has uncommitted changes')
            } else {
                assert workflow.success
                def pre = new groovy.json.JsonSlurper().parse(file("$outputDir/pipeline_info/preregistration_check.json"))
                assert pre.preregistered == true
                assert pre.problems == []
                def verdict = new groovy.json.JsonSlurper().parse(file("$outputDir/concordance/concordance_summary.verdict.json"))
                assert verdict.preregistered == true
            }
        }
    }

    test("the Cell Ranger version to match must be stated") {
        when {
            params {
                outdir = "$outputDir"
                cellranger_compat = null
            }
        }
        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains('--cellranger_compat must be cr3 or cr4')
        }
    }

    test("a duplicated sample name is refused before anything runs") {
        when {
            def bam = "${projectDir}/tests/data/sampleA.bam"
            new File("$outputDir").mkdirs()
            new File("$outputDir/dup.csv").text =
                "sample,bam,chemistry,published_label\nsampleA,${bam},v3,MB001\nsampleA,${bam},v3,MB001\n"
            params {
                outdir = "$outputDir"
                input  = "$outputDir/dup.csv"
            }
        }
        then {
            assert workflow.failed
            assert !(workflow.stdout + workflow.stderr).join('\n').contains('BAMTOFASTQ')
            assert (workflow.stdout + workflow.stderr).join('\n').contains("duplicate sample 'sampleA'")
        }
    }
}
