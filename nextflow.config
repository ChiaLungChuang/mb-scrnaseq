manifest {
    name            = 'mb-scrnaseq'
    description     = 'Re-quantify childhood medulloblastoma 10x scRNA-seq (GSE155446) and test it against the published counts'
    author          = 'Chia-Lung Chuang'
    homePage        = 'https://github.com/ChiaLungChuang/mb-scrnaseq'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '0.1.0'
}

params {
    // Inputs
    input                  = null     // samplesheet CSV: sample,bam,chemistry,published_label
    outdir                 = 'results'

    // Reference: either a pre-built STAR index, or FASTA + GTF to build one
    star_index             = null
    genome_fasta           = null
    genome_gtf             = null
    star_sjdb_overhang     = 100
    star_genome_sa_index_nbases = 14  // 14 for human; tiny test genomes need ~6

    // 10x barcode whitelists (plain or .gz). v2: 737K-august-2016, v3: 3M-february-2018
    whitelist_v2           = null
    whitelist_v3           = null

    // Cell Ranger major version to match (required): 'cr3' or 'cr4'. The BAM
    // header's @PG/@CO lines name it. GSE155446 was made with Cell Ranger 3.x.
    cellranger_compat      = null

    // STARsolo cell calling (Cell Ranger-style EmptyDrops by default)
    solo_cell_filter       = 'EmptyDrops_CR'

    // QC
    qc_nmads               = 3

    // Concordance against the published matrix (skipped when published_counts is null)
    published_counts       = null     // e.g. GSE155446_human_raw_counts.csv.gz
    published_chunk_rows   = 2000
    criteria               = "${projectDir}/preregistration/acceptance_criteria.yaml"
    allow_unlocked_criteria = false   // true skips the pre-registration gate: test runs only

    // R environment for the analysis steps (built from containers/r-analysis/Dockerfile),
    // pinned by digest so that re-pushing the tag cannot change what a run uses.
    // The tag must equal manifest.version (scripts/check_versions.sh, run by CI).
    // New version: drop the digest and change the tag, release, then pin the new
    // digest (docs/RUNBOOK.md, section 0).
    // Standalone server (-profile server): the share of the machine this run
    // may use, and the launch checks (conf/server.config, main.nf checkServer).
    server_check           = false
    server_cpus            = null      // e.g. 32
    server_memory          = null      // e.g. '200.GB'
    server_min_memory      = '48.GB'   // the STAR index build and STARsolo ask for 48 GB
    server_disk_margin     = '20.GB'   // free disk kept beyond one tumor's needs

    r_container            = 'ghcr.io/chialungchuang/mb-scrnaseq-r:0.1.0@sha256:9ce6480a75f1918f0ccd509f12207c642f4ed2bc88898309e187a7cb828367a5'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        singularity.enabled    = false
        docker.enabled         = false
    }
    // St. Jude HPCF: LSF scheduler + Singularity (Docker is not available there)
    stjude {
        includeConfig 'conf/stjude.config'
    }
    // Tiny synthetic dataset in tests/data; runs in about a minute
    test {
        includeConfig 'conf/test.config'
    }
    // Harder synthetic dataset with known exact counts (see conf/test_accuracy.config)
    test_accuracy {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_accuracy.config'
    }
    // The R image built from this checkout instead of the published one, for
    // testing Dockerfile changes with Docker (CI uses it):
    //   docker build -t mb-scrnaseq-r:local containers/r-analysis
    local_r_image {
        params.r_container = 'mb-scrnaseq-r:local'
    }
    // One Linux server without a scheduler (local executor), with a container
    // profile: -profile server,singularity|apptainer|docker. Defined after
    // `test`, so test runs' server settings are in place when it is read.
    server {
        includeConfig 'conf/server.config'
    }
    // Tools already on PATH (no containers): for development only
    local_tools {
        docker.enabled      = false
        singularity.enabled = false
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
// Raw numbers (milliseconds, bytes, plain %cpu) so bin/phase1_report.R can
// compute CPU hours and peak memory without parsing "1h 2m" or "1.2 GB".
trace {
    enabled   = true
    overwrite = true
    raw       = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    fields    = 'task_id,hash,native_id,process,tag,status,exit,attempt,queue,cpus,memory,time,submit,realtime,%cpu,peak_rss,workdir'
}
