manifest {
    name            = 'mb-scrnaseq'
    description     = 'Re-quantify childhood medulloblastoma 10x scRNA-seq (GSE155446) and test it against the published counts'
    author          = 'Chia-Lung Chuang'
    homePage        = 'https://github.com/ChiaLungChuang/mb-scrnaseq'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '0.1.0'
}

params {
    // Inputs
    input                  = null     // samplesheet CSV: sample,bam,chemistry,published_label
    outdir                 = 'results'

    // Reference: either a pre-built STAR index, or FASTA + GTF to build one
    star_index             = null
    genome_fasta           = null
    genome_gtf             = null
    star_sjdb_overhang     = 100
    star_genome_sa_index_nbases = 14  // 14 for human; tiny test genomes need ~6

    // 10x barcode whitelists (plain or .gz). v2: 737K-august-2016.txt, v3: 3M-february-2018.txt
    whitelist_v2           = null
    whitelist_v3           = null

    // STARsolo cell calling (Cell Ranger-style EmptyDrops by default)
    solo_cell_filter       = 'EmptyDrops_CR'

    // QC
    qc_nmads               = 3

    // Concordance against the published matrix (skipped when published_counts is null)
    published_counts       = null     // e.g. GSE155446_human_raw_counts.csv.gz
    published_chunk_rows   = 2000
    criteria               = "${projectDir}/preregistration/acceptance_criteria.yaml"
    allow_unlocked_criteria = false

    // R environment for the analysis steps (built from containers/r-analysis/Dockerfile)
    r_container            = 'ghcr.io/chialungchuang/mb-scrnaseq-r:0.1.0'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    // St. Jude HPCF: LSF scheduler + Singularity (Docker is not available there)
    stjude {
        includeConfig 'conf/stjude.config'
    }
    // Tiny synthetic dataset in tests/data; runs in about a minute
    test {
        includeConfig 'conf/test.config'
    }
    // Tools already on PATH (no containers): for development only
    local_tools {
        docker.enabled      = false
        singularity.enabled = false
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    fields    = 'task_id,hash,native_id,process,tag,status,exit,submit,realtime,%cpu,peak_rss,workdir'
}
